{
  "name": "tiboping",
  "version": "0.1.0",
  "private": true,
  "description": "Never miss a Tibo post that matters.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @tiboping/core && npm run build -w @tiboping/web && npm run build -w @tiboping/server",
    "dev": "npm run build -w @tiboping/core && concurrently -k -n core,server,web -c cyan,magenta,yellow \"npm run dev -w @tiboping/core\" \"npm run dev -w @tiboping/server\" \"npm run dev -w @tiboping/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:docker": "node scripts/docker-smoke.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.4",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
