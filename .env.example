# Generate with: openssl rand -base64 32
APP_SECRET=

# Use a long, unique password. Do not commit the populated .env file.
ADMIN_PASSWORD=

# Official X API app bearer token. Optional when DEMO_MODE=true.
X_BEARER_TOKEN=

PUBLIC_URL=http://localhost:3000
PORT=3000
DATABASE_PATH=/data/tiboping.sqlite
LOG_LEVEL=info
DEMO_MODE=false
ALLOW_PRIVATE_WEBHOOKS=false
